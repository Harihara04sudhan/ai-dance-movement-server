# Environment variables for Dance Movement Analysis API

# Server configuration
PORT=8000
HOST=0.0.0.0

# MediaPipe confidence thresholds
MIN_DETECTION_CONFIDENCE=0.5
MIN_TRACKING_CONFIDENCE=0.5

# File cleanup (in seconds)
FILE_RETENTION_TIME=3600

# Logging
LOG_LEVEL=INFO

# Security (see api_server.py security middleware)
# Require X-API-Key header on /api/* routes. Leave empty to disable (dev only).
API_KEY=
MAX_UPLOAD_MB=100
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
